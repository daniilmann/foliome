{
  "name": "foliome",
  "version": "1.0.0",
  "description": "Open-source financial data infrastructure for AI agents",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint core base scripts/checks test",
    "format:check": "prettier --check 'core/**/*.ts' 'base/*.js' 'scripts/checks/**/*.ts' 'test/**/*.ts' package.json tsconfig.json eslint.config.mjs .prettierrc.json",
    "test": "node --test --test-concurrency=1 scripts/checks/unit/*.test.ts",
    "test:stand": "node --test --test-concurrency=1 test/stand/*.test.ts",
    "test:attacks": "node --test --test-concurrency=1 test/attacks/*.test.ts"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.15.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
